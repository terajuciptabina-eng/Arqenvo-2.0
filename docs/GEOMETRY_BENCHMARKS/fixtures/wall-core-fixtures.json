{
  "schemaVersion": 1,
  "project": "ARQENVO 2.0",
  "purpose": "Shared analytic fixtures for isolated browser geometry-kernel spikes. These are kernel-neutral inputs, not Archicad's proprietary internal data format.",
  "units": {
    "length": "mm",
    "angle": "degree",
    "coordinateSystem": "right-handed",
    "upAxis": "Z"
  },
  "tolerancePolicy": {
    "status": "not-yet-approved",
    "rule": "Each candidate run must record its configured modelling tolerance and measured dimensional deviation. Do not silently substitute candidate defaults or compare results without recording them."
  },
  "cases": [
    {
      "id": "K01",
      "name": "straight-wall-prism",
      "purpose": "Baseline profile extrusion and solid validity",
      "wall": {
        "id": "wall-k01",
        "baseline": [
          [
            0,
            0
          ],
          [
            1000,
            0
          ]
        ],
        "referenceLine": "center",
        "thickness": 200,
        "baseElevation": 0,
        "height": 3000
      },
      "expected": {
        "closedSolid": true,
        "boundingDimensions": [
          1000,
          200,
          3000
        ],
        "volumeMm3": 600000000
      }
    },
    {
      "id": "K02",
      "name": "quarter-annular-curved-wall",
      "purpose": "Exact curved wall body generated by revolving a rectangular radial-height profile",
      "wall": {
        "id": "wall-k02",
        "centerlineRadius": 1000,
        "thickness": 200,
        "innerRadius": 900,
        "outerRadius": 1100,
        "baseElevation": 0,
        "height": 3000,
        "sweepAngleRadians": 1.5707963267948966
      },
      "expected": {
        "closedSolid": true,
        "volumeMm3": 942477796.0769379,
        "boundingDimensions": [
          1100,
          1100,
          3000
        ],
        "absoluteVolumeToleranceMm3": 0.1
      }
    },
    {
      "id": "K03",
      "name": "two-wall-l-junction",
      "purpose": "Kernel-neutral solid construction and union after an independently supplied wall-end solution",
      "walls": [
        {
          "id": "wall-k03-a",
          "baseline": [
            [
              0,
              0
            ],
            [
              3000,
              0
            ]
          ],
          "referenceLine": "center",
          "thickness": 200,
          "baseElevation": 0,
          "height": 3000
        },
        {
          "id": "wall-k03-b",
          "baseline": [
            [
              3000,
              0
            ],
            [
              3000,
              2000
            ]
          ],
          "referenceLine": "center",
          "thickness": 200,
          "baseElevation": 0,
          "height": 3000
        }
      ],
      "junctionInput": {
        "type": "L",
        "angle": 90,
        "policy": "Use the same precomputed wall-end boundaries for every candidate. Do not ask the kernel to invent BIM junction priority or trim rules."
      },
      "expected": {
        "closedSolidOrValidSolidSet": true,
        "noUnintendedGapAtJunction": true,
        "noDuplicateInternalFacesInMergedResult": true,
        "volumeMm3": 2970000000,
        "boundingDimensions": [
          3100,
          2100,
          3000
        ]
      },
      "solidConstruction": [
        {
          "wallId": "wall-k03-a",
          "boxMin": [
            0,
            -100,
            0
          ],
          "boxMax": [
            3000,
            100,
            3000
          ]
        },
        {
          "wallId": "wall-k03-b",
          "boxMin": [
            2900,
            0,
            0
          ],
          "boxMax": [
            3100,
            2000,
            3000
          ]
        }
      ]
    },
